#!/usr/bin/env bash
set -euo pipefail

readonly VERSION='0.1.0'
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
config_file="${JBL_AURA_CONFIG:-${config_home}/jbl-aura-link/devices.env}"

load_config() {
  [[ -f "${config_file}" ]] || return 0
  local key value
  while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
    [[ -n "${key}" && "${key}" != \#* ]] || continue
    value="${value%$'\r'}"
    case "${key}" in
      BT_ADAPTER | JBL_BT_MAC | JBL_DEVICE_NAME | JBL_GATT_HANDLE | \
        JBL_GATT_MTU | JBL_AURACAST_QUALITY | JBL_GATT_TIMEOUT | \
        JBL_CONNECT_DELAY | JBL_STEP_DELAY | AURA_BT_MAC | \
        AURA_GATT_HANDLE | AURA_GATT_PSM | AURA_GATT_TIMEOUT | \
        AURA_GATT_RETRIES | AURA_JOIN_DELAY | DISCONNECT_AURA_A2DP)
        printf -v "${key}" '%s' "${value}"
        ;;
    esac
  done <"${config_file}"
}

load_config

: "${BT_ADAPTER:=hci0}"
: "${JBL_DEVICE_NAME:=JBL Authentics 300}"
: "${JBL_GATT_HANDLE:=0x002a}"
: "${JBL_GATT_MTU:=500}"
: "${JBL_AURACAST_QUALITY:=0}"
: "${JBL_GATT_TIMEOUT:=22}"
: "${JBL_CONNECT_DELAY:=3}"
: "${JBL_STEP_DELAY:=2}"
: "${AURA_GATT_HANDLE:=0x03ea}"
: "${AURA_GATT_PSM:=31}"
: "${AURA_GATT_TIMEOUT:=12}"
: "${AURA_GATT_RETRIES:=3}"
: "${AURA_JOIN_DELAY:=2}"
: "${DISCONNECT_AURA_A2DP:=true}"
: "${GATTTOOL_BIN:=gatttool}"

readonly JBL_CMD_ENTER_AURACAST=7937
readonly JBL_CMD_EXIT_AURACAST=7938
readonly JBL_CMD_SET_AURACAST_BROADCAST=7957
readonly AURA_PLAY_TOGETHER_ON='aa1304003c0101'
readonly AURA_PLAY_TOGETHER_OFF='aa1304003c0100'
readonly A2DP_SINK_UUID='0000110b-0000-1000-8000-00805f9b34fb'

state_root="${XDG_STATE_HOME:-${HOME}/.local/state}"
readonly STATE_DIR="${state_root}/jbl-aura-link"
readonly A2DP_MARKER="${STATE_DIR}/a2dp-was-active"

START_TRANSACTION_ACTIVE=0
START_JBL_WRITTEN=0
START_AURA_ATTEMPTED=0
START_ROLLBACK_STOP_FRAME=''
START_ROLLBACK_EXIT_FRAME=''

log() {
  printf '[jbl-aura-link] %s\n' "$*"
}

fail() {
  printf '[jbl-aura-link] error: %s\n' "$*" >&2
  return 1
}

redact_transport_output() {
  # Transport errors often echo the peer address. Keep diagnostics useful while
  # making copied issue reports safe by default.
  LC_ALL=C sed -E \
    's/([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}/<bluetooth-address>/g'
}

is_true() {
  case "${1,,}" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

require_gatttool() {
  if [[ "${GATTTOOL_BIN}" == */* ]]; then
    [[ -x "${GATTTOOL_BIN}" ]] || fail "GATTTOOL_BIN is not executable: ${GATTTOOL_BIN}"
  else
    require_command "${GATTTOOL_BIN}"
  fi
}

validate_mac() {
  [[ "$1" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]
}

validate_config() {
  local jbl_mac="${JBL_BT_MAC:-}"
  local aura_mac="${AURA_BT_MAC:-}"

  if [[ -z "${jbl_mac}" ]]; then
    fail "set JBL_BT_MAC in ${config_file}"
    return 1
  fi
  if [[ -z "${aura_mac}" ]]; then
    fail "set AURA_BT_MAC in ${config_file}"
    return 1
  fi
  if ! validate_mac "${jbl_mac}"; then
    fail "invalid JBL_BT_MAC: ${jbl_mac}"
    return 1
  fi
  if ! validate_mac "${aura_mac}"; then
    fail "invalid AURA_BT_MAC: ${aura_mac}"
    return 1
  fi
  if [[ ! "${JBL_AURACAST_QUALITY}" =~ ^[0-9]+$ ]]; then
    fail 'JBL_AURACAST_QUALITY must be a non-negative integer'
    return 1
  fi
  if [[ ! "${JBL_GATT_MTU}" =~ ^[0-9]+$ ]] || ((JBL_GATT_MTU <= 3)); then
    fail 'JBL_GATT_MTU must be an integer greater than 3'
    return 1
  fi
  if [[ ! "${AURA_GATT_PSM}" =~ ^[0-9]+$ ]]; then
    fail 'AURA_GATT_PSM must be a non-negative integer'
    return 1
  fi
  if [[ ! "${AURA_GATT_RETRIES}" =~ ^[1-9][0-9]*$ ]]; then
    fail 'AURA_GATT_RETRIES must be a positive integer'
    return 1
  fi
  local numeric_value
  for numeric_value in "${JBL_GATT_TIMEOUT}" "${JBL_CONNECT_DELAY}" \
    "${JBL_STEP_DELAY}" "${AURA_GATT_TIMEOUT}" "${AURA_JOIN_DELAY}"; do
    if [[ ! "${numeric_value}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      fail 'timeouts and delays must be non-negative numbers'
      return 1
    fi
  done
}

acquire_lock() {
  require_command flock
  local runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  exec 9>"${runtime_dir}/jbl-aura-link.lock"
  flock -n 9 || fail 'another link operation is running'
}

build_pl_frame() {
  local command_id="$1"
  local payload="${2-}"
  local payload_length command_low command_high length_low length_high payload_hex

  [[ "${command_id}" =~ ^[0-9]+$ ]] || fail "invalid PL command ID: ${command_id}"
  payload_length="$(LC_ALL=C printf '%s' "${payload}" | wc -c)"
  payload_length="${payload_length//[[:space:]]/}"
  ((payload_length <= 65535)) || fail 'PL payload exceeds 65535 bytes'

  printf -v command_low '%02x' "$((command_id & 255))"
  printf -v command_high '%02x' "$(((command_id >> 8) & 255))"
  printf -v length_low '%02x' "$((payload_length & 255))"
  printf -v length_high '%02x' "$(((payload_length >> 8) & 255))"
  payload_hex="$(LC_ALL=C printf '%s' "${payload}" | xxd -p -c 100000 | tr -d '\n')"

  printf '504c%s%s%s%s%s' \
    "${command_low}" "${command_high}" "${length_low}" "${length_high}" "${payload_hex}"
}

build_start_payload() {
  jq -cn \
    --arg address "${JBL_BT_MAC}" \
    --arg name "${JBL_DEVICE_NAME}" \
    --argjson quality "${JBL_AURACAST_QUALITY}" \
    '{action: 1, broadcast: {
      address: $address,
      name: $name,
      need_access_code: false,
      status: 2,
      subgroup: [{active_status: 1, index: 0, is_support: true, quality: $quality}]
    }}'
}

validate_frames_for_mtu() {
  local frame frame_bytes
  local max_frame_bytes=$((JBL_GATT_MTU - 3))
  for frame in "$@"; do
    [[ "${frame}" =~ ^([[:xdigit:]]{2})+$ ]] || fail 'PL frame is not even-length hexadecimal'
    frame_bytes=$((${#frame} / 2))
    ((frame_bytes <= max_frame_bytes)) ||
      fail "PL frame ${frame_bytes} bytes exceeds MTU write limit ${max_frame_bytes}"
  done
}

jbl_write_frames() {
  local -a frames=("$@")
  validate_frames_for_mtu "${frames[@]}"

  local output rc success_count expected_count frame
  expected_count="${#frames[@]}"
  set +e
  output="$({
    printf 'connect\n'
    sleep "${JBL_CONNECT_DELAY}"
    printf 'mtu %s\n' "${JBL_GATT_MTU}"
    sleep "${JBL_STEP_DELAY}"
    for frame in "${frames[@]}"; do
      printf 'char-write-req %s %s\n' "${JBL_GATT_HANDLE}" "${frame}"
      sleep "${JBL_STEP_DELAY}"
    done
    printf 'exit\n'
  } | timeout -k 2s "${JBL_GATT_TIMEOUT}" \
    "${GATTTOOL_BIN}" -i "${BT_ADAPTER}" -b "${JBL_BT_MAC}" -t public -I 2>&1)"
  rc=$?
  set -e

  success_count="$(grep -cF 'Characteristic value was written successfully' <<<"${output}" || true)"
  if ((rc != 0)) || ! grep -Fq 'Connection successful' <<<"${output}" ||
    ! grep -Fq "MTU was exchanged successfully: ${JBL_GATT_MTU}" <<<"${output}" ||
    ((success_count != expected_count)); then
    redact_transport_output <<<"${output}" >&2
    fail "JBL transport was not fully acknowledged (rc=${rc}, writes=${success_count}/${expected_count})"
    return 1
  fi
  log "JBL transport acknowledged ${success_count} write(s)"
}

aura_write() {
  local frame="$1"
  local label="$2"
  local output='' rc=1 attempt

  for ((attempt = 1; attempt <= AURA_GATT_RETRIES; attempt++)); do
    set +e
    output="$(timeout -k 2s "${AURA_GATT_TIMEOUT}" \
      "${GATTTOOL_BIN}" -i "${BT_ADAPTER}" -b "${AURA_BT_MAC}" -p "${AURA_GATT_PSM}" \
      --char-write-req -a "${AURA_GATT_HANDLE}" -n "${frame}" 2>&1)"
    rc=$?
    set -e
    if ((rc == 0)) && grep -Fq 'Characteristic value was written successfully' <<<"${output}"; then
      log "Aura ${label} write acknowledged (attempt ${attempt})"
      return 0
    fi
    ((attempt < AURA_GATT_RETRIES)) && sleep 1
  done

  redact_transport_output <<<"${output}" >&2
  fail "Aura ${label} was not acknowledged (rc=${rc}, attempts=${AURA_GATT_RETRIES})"
}

aura_device_path() {
  printf '/org/bluez/%s/dev_%s' "${BT_ADAPTER}" "${AURA_BT_MAC//:/_}"
}

aura_a2dp_active() {
  local device_path sink_name
  device_path="$(aura_device_path)"
  sink_name="bluez_sink.${AURA_BT_MAC//:/_}.a2dp_sink"
  if command -v pactl >/dev/null 2>&1 &&
    pactl list sinks short 2>/dev/null | grep -Fq "${sink_name}"; then
    return 0
  fi
  busctl get-property org.bluez "${device_path}" org.bluez.MediaControl1 Connected \
    2>/dev/null | grep -Fq 'true'
}

disconnect_aura_a2dp() {
  is_true "${DISCONNECT_AURA_A2DP}" || return 0
  require_command busctl
  local device_path attempt
  device_path="$(aura_device_path)"

  if ! aura_a2dp_active; then
    log 'Aura A2DP is not active'
    return 0
  fi

  busctl call org.bluez "${device_path}" org.bluez.Device1 DisconnectProfile \
    s "${A2DP_SINK_UUID}" >/dev/null 2>&1 || true
  for attempt in {1..6}; do
    if ! aura_a2dp_active; then
      umask 077
      mkdir -p "${STATE_DIR}"
      printf 'restore-on-stop\n' >"${A2DP_MARKER}"
      log 'Aura A2DP profile released'
      return 0
    fi
    sleep 0.5
  done
  fail 'Aura A2DP remained active; refusing to continue'
}

restore_aura_a2dp() {
  [[ -f "${A2DP_MARKER}" ]] || return 0
  local device_path
  device_path="$(aura_device_path)"
  if busctl call org.bluez "${device_path}" org.bluez.Device1 ConnectProfile \
    s "${A2DP_SINK_UUID}" >/dev/null 2>&1; then
    rm -f -- "${A2DP_MARKER}"
    log 'Aura A2DP profile restored'
  else
    fail 'could not restore Aura A2DP; the private state marker was kept'
  fi
}

rollback_start_transaction() {
  local original_rc="$1"
  trap - EXIT INT TERM
  if ((START_TRANSACTION_ACTIVE == 1)); then
    log 'start was not committed; restoring the previous state'
    if ((START_AURA_ATTEMPTED == 1)); then
      aura_write "${AURA_PLAY_TOGETHER_OFF}" 'rollback-off' || true
    fi
    if ((START_JBL_WRITTEN == 1)); then
      jbl_write_frames "${START_ROLLBACK_STOP_FRAME}" "${START_ROLLBACK_EXIT_FRAME}" || true
    fi
    restore_aura_a2dp || true
  fi
  exit "${original_rc}"
}

start_link() {
  validate_config
  require_gatttool
  require_command jq
  require_command timeout
  require_command xxd
  acquire_lock

  local enter_frame start_payload start_frame
  enter_frame="$(build_pl_frame "${JBL_CMD_ENTER_AURACAST}")"
  start_payload="$(build_start_payload)"
  start_frame="$(build_pl_frame "${JBL_CMD_SET_AURACAST_BROADCAST}" "${start_payload}")"
  START_ROLLBACK_STOP_FRAME="$(build_pl_frame "${JBL_CMD_SET_AURACAST_BROADCAST}" '{"action":2}')"
  START_ROLLBACK_EXIT_FRAME="$(build_pl_frame "${JBL_CMD_EXIT_AURACAST}")"

  START_TRANSACTION_ACTIVE=1
  START_JBL_WRITTEN=0
  START_AURA_ATTEMPTED=0
  trap 'rollback_start_transaction $?' EXIT INT TERM

  disconnect_aura_a2dp
  # Mark the JBL phase as attempted before the batched transport call. If only
  # the first write lands, the EXIT rollback is still required.
  START_JBL_WRITTEN=1
  jbl_write_frames "${enter_frame}" "${start_frame}"
  sleep "${AURA_JOIN_DELAY}"
  START_AURA_ATTEMPTED=1
  aura_write "${AURA_PLAY_TOGETHER_ON}" 'play-together-on'

  START_TRANSACTION_ACTIVE=0
  trap - EXIT INT TERM
  log 'link sequence completed'
  log 'Transport ACK is not proof of BASS. Verify success by listening to both speakers.'
}

stop_link() {
  validate_config
  require_gatttool
  require_command jq
  require_command timeout
  require_command xxd
  acquire_lock

  local failed=0 stop_frame exit_frame
  if ! aura_write "${AURA_PLAY_TOGETHER_OFF}" 'play-together-off'; then
    failed=1
  fi
  stop_frame="$(build_pl_frame "${JBL_CMD_SET_AURACAST_BROADCAST}" '{"action":2}')"
  exit_frame="$(build_pl_frame "${JBL_CMD_EXIT_AURACAST}")"
  if ! jbl_write_frames "${stop_frame}" "${exit_frame}"; then
    failed=1
  fi
  if ! restore_aura_a2dp; then
    failed=1
  fi
  ((failed == 0)) || return 1
  log 'unlink sequence completed'
}

refresh_jbl_advertisement() {
  timeout 4 bluetoothctl scan on >/dev/null 2>&1 || true
  bluetoothctl scan off >/dev/null 2>&1 || true
}

jbl_service_data() {
  bluetoothctl info "${JBL_BT_MAC}" 2>/dev/null | awk '
    tolower($0) ~ /servicedata key:.*dffd/ { wanted = 1; next }
    wanted && /ServiceData Value:/ { capture = 1; next }
    capture {
      found = 0
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[[:xdigit:]][[:xdigit:]]$/) {
          printf "%s%s", (count++ ? " " : ""), tolower($i)
          found = 1
        } else if (found) break
      }
      if (found) next
      exit
    }
  '
}

decode_role() {
  local service_data="$1"
  local -a bytes=()
  read -r -a bytes <<<"${service_data}"
  if ((${#bytes[@]} < 16)); then
    printf 'UNKNOWN'
    return 0
  fi
  local role=$((16#${bytes[14]} & 3))
  case "${role}" in
    0) printf 'NORMAL(0)' ;;
    1) printf 'BROADCAST(1)' ;;
    2) printf 'RECEIVER(2)' ;;
    *) printf 'UNKNOWN(%s)' "${role}" ;;
  esac
}

show_status() {
  validate_config
  require_command bluetoothctl
  acquire_lock
  trap 'bluetoothctl scan off >/dev/null 2>&1 || true' EXIT INT TERM
  refresh_jbl_advertisement

  local service_data role
  service_data="$(jbl_service_data)"
  role="$(decode_role "${service_data}")"
  log "JBL DFFD role: ${role}"
  log 'This field is diagnostic only. A verified two-speaker run showed RECEIVER(2); the earlier BASS read was inconclusive.'
  log 'Association state: UNKNOWN unless confirmed acoustically.'
  trap - EXIT INT TERM
}

doctor() {
  local failures=0 command_name
  for command_name in bluetoothctl busctl flock jq timeout xxd; do
    if command -v "${command_name}" >/dev/null 2>&1; then
      log "dependency ${command_name}: OK"
    else
      log "dependency ${command_name}: MISSING"
      failures=$((failures + 1))
    fi
  done
  if require_gatttool; then
    log 'dependency gatttool: OK'
  else
    failures=$((failures + 1))
  fi
  if ! validate_config; then
    failures=$((failures + 1))
  fi

  local powered
  powered="$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2; exit}')"
  log "BlueZ $(bluetoothctl --version 2>/dev/null || true); adapter powered=${powered:-unknown}"

  if [[ -n "${JBL_BT_MAC:-}" ]] && bluetoothctl info "${JBL_BT_MAC}" 2>/dev/null |
    grep -Fq 'Paired: yes'; then
    log 'JBL pairing: OK'
  else
    log 'JBL pairing: NOT CONFIRMED'
    failures=$((failures + 1))
  fi
  if [[ -n "${AURA_BT_MAC:-}" ]] && bluetoothctl info "${AURA_BT_MAC}" 2>/dev/null |
    grep -Fq 'Paired: yes'; then
    log 'Aura pairing: OK'
  else
    log 'Aura pairing: NOT CONFIRMED'
    failures=$((failures + 1))
  fi

  ((failures == 0)) || fail "doctor found ${failures} blocking issue(s)"
  log 'doctor: PASS'
}

print_frame() {
  validate_config
  require_command jq
  require_command xxd
  case "${1:-start}" in
    enter) build_pl_frame "${JBL_CMD_ENTER_AURACAST}" ;;
    start) build_pl_frame "${JBL_CMD_SET_AURACAST_BROADCAST}" "$(build_start_payload)" ;;
    stop) build_pl_frame "${JBL_CMD_SET_AURACAST_BROADCAST}" '{"action":2}' ;;
    exit) build_pl_frame "${JBL_CMD_EXIT_AURACAST}" ;;
    *) fail "unknown frame type: $1"; return 1 ;;
  esac
  printf '\n'
}

usage() {
  cat <<'EOF'
Usage: jbl-aura-link <command>

Commands:
  doctor          Check dependencies, configuration, adapter and pairing
  start           Send the vendor link sequence
  stop            Send the vendor unlink sequence
  status          Show conservative DFFD diagnostics
  frame [type]    Print enter/start/stop/exit PL frame without hardware access
  version         Print the CLI version

The tool does not play audio. Start playback on the JBL through any supported
source, then verify both speakers acoustically.
EOF
}

main() {
  case "${1:-}" in
    doctor) doctor ;;
    start) start_link ;;
    stop) stop_link ;;
    status) show_status ;;
    frame) print_frame "${2:-start}" ;;
    version | --version) printf '%s\n' "${VERSION}" ;;
    -h | --help | help) usage ;;
    *) usage >&2; return 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
