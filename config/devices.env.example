# Copy to config/devices.env. Never commit the real file.
BT_ADAPTER=hci0

# Locally administered placeholders. Replace both with your own paired devices.
JBL_BT_MAC=02:00:00:00:00:01
AURA_BT_MAC=02:00:00:00:00:02

JBL_DEVICE_NAME=JBL Authentics 300
JBL_GATT_HANDLE=0x002a
JBL_GATT_MTU=500
JBL_AURACAST_QUALITY=0

AURA_GATT_HANDLE=0x03ea
AURA_GATT_PSM=31

# The Aura cannot receive the vendor link while Ubuntu owns its A2DP sink.
DISCONNECT_AURA_A2DP=true
