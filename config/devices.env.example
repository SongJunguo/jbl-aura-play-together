# Copy to ~/.config/jbl-aura-link/devices.env and set mode 600.
# Never put the real file inside the repository.
BT_ADAPTER=hci0

# Locally administered placeholders. Replace both with your own paired devices.
JBL_BT_MAC=02:00:00:00:00:01
AURA_BT_MAC=02:00:00:00:00:02

JBL_DEVICE_NAME=JBL Authentics 300
JBL_GATT_HANDLE=0x002a
JBL_GATT_MTU=500
JBL_AURACAST_QUALITY=0

AURA_DEVICE_NAME=Aura Studio 5
# auto first resolves a verified rotating LE address from live FDDF
# advertisements, then retains paired BR/EDR as a compatibility fallback.
# bredr and le force one path.
AURA_TRANSPORT=auto
AURA_V4_PID=212d
AURA_GATT_HANDLE=0x03ea
AURA_GATT_CCCD_HANDLE=0x03ed
AURA_GATT_PSM=31
AURA_CONTROL_SETTLE=1
BLUEZ_CONTROL_TIMEOUT=5

# Persistent session supervisor. It keeps both control bearers open so stop
# does not need to reconnect after the speakers enter PartyTogether roles.
# Maximum wait for supervisor startup and each local lifecycle command.
SESSION_START_TIMEOUT=180
SESSION_CONNECT_TIMEOUT=18
# Overall Aura acquisition deadline, including live LE scan and ATT connect.
SESSION_AURA_CONNECT_WINDOW=150
# Each FDDF scan burst. Two delayed retries yield at most three scan bursts.
SESSION_AURA_LE_SCAN_WINDOW=30
SESSION_AURA_LE_RETRIES=2
SESSION_AURA_LE_RETRY_DELAY=15
SESSION_WRITE_TIMEOUT=8
SESSION_AURA_ACK_TIMEOUT=8

# auto prefers an installed user service, otherwise a transient user-systemd
# unit, and finally a detached process. systemd and direct force one method.
SESSION_LAUNCH_MODE=auto

# The Aura cannot receive the vendor link while Ubuntu owns its A2DP sink.
# If false, an active A2DP profile is left untouched and start/stop fail safely.
DISCONNECT_AURA_A2DP=true

# A full Device1 disconnect can destroy the ACL or short LE discovery window.
# Keep false for normal managed start. Enable only for explicit stale-state
# recovery after collecting evidence that preserving the ACL cannot work.
BLUEZ_FULL_DISCONNECT_BEFORE_SESSION=false

# On PulseAudio systems, auto temporarily releases only the Bluetooth modules
# while the two control sessions connect, then restores them even on rollback.
PULSEAUDIO_BLUETOOTH_GUARD=auto

# Python interpreter containing dbus-fast from requirements-le.txt.
# Point this at the dedicated venv created in the README.
PYTHON_BIN=python3
